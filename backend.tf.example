# Rename to backend.tf and fill in. Requires Terraform 1.10+ for S3-native locking.
# State bucket should have versioning, Block Public Access, SSE-KMS with a CMK,
# and a bucket policy denying non-TLS access (aws:SecureTransport = false).

terraform {
  backend "s3" {
    bucket            = "acme-tfstate-123456789012-us-gov-west-1"
    key               = "network/fedramp-moderate-vpc/prod.tfstate"
    region            = "us-gov-west-1"
    encrypt           = true
    kms_key_id        = "arn:aws-us-gov:kms:us-gov-west-1:123456789012:key/REPLACE-ME"
    use_lockfile      = true
    use_fips_endpoint = true
  }
}
